# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Derived at build time by scripts/gen-coverage.mjs (prebuild) from src/lib/coverage.js — see phase 188/TT contract.
public/coverage.json

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Covers bare `.env` plus every variant, including suffixed ones
# like .env.bak and .env.save that exact-match rules miss.
.env
.env.*
!.env.example
!.env.*.example
.superpowers/

# Throwaway one-off migration/seed scripts (often hold ad-hoc creds — keep out of git)
scripts/_tmp*
supabase/.temp/

# Python
__pycache__/
*.pyc

# Playwright MCP artifacts
.playwright-mcp/

# Editor/tooling backups. A `.env.bak` holding live credentials sat
# untracked in ev-accounts on 2026-07-26 and a single `git add -A`
# would have published it.
*.bak
*.backup
*.orig
*~
